# ===================================================================
# Bridge Group Solutions - Hostinger Production Configuration
# LiteSpeed / Apache Web Server Optimized
# ===================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Set Default Character Set
AddDefaultCharset UTF-8

# 3. Custom Error Pages
ErrorDocument 404 /404.html

# 4. URL Rewriting & HTTPS Redirection
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Force HTTPS on Production (exclude localhost/127.0.0.1)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Canonical Domain Redirection (Non-WWW to WWW for bridgegroupsolutions.com)
    RewriteCond %{HTTP_HOST} ^bridgegroupsolutions\.com$ [NC]
    RewriteRule ^(.*)$ https://www.bridgegroupsolutions.com/$1 [L,R=301]

    # C. Universal Clean URLs (Allow accessing /about, /services/web without .html extension)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 5. Enterprise Security Headers & HSTS
<IfModule mod_headers.c>
    # Enforce HTTPS connections for 1 year, including subdomains and preloading
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Automatically upgrade all insecure requests to HTTPS
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer policy for privacy and SEO attribution
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 6. Gzip / Deflate Compression (LiteSpeed & Apache)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 7. Browser Caching & Performance (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML files: Short cache for instant release updates
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Media / Images: 1 Year Cache
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts: 1 Year Cache
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Data files
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

# 8. Prevent Access to Sensitive / System Files
<FilesMatch "(\.(htaccess|htpasswd|git|env|pem|key|yaml|yml)$|^https-server\.js$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to local certificates directory if present
RedirectMatch 404 ^/certs/.*$
